@baseUrl = http://localhost:8000/api
@accessToken = paste_access_token_here
@username = ama_mensah
@profilePhotoPath = C:\Users\User\Pictures\profile.jpg

### Get my profile
GET {{baseUrl}}/users/me
Authorization: Bearer {{accessToken}}

### Update my profile with JSON
PUT {{baseUrl}}/users/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Ama Mensah",
  "phone": "+233501234567",
  "region": "Greater Accra",
  "city": "Accra"
}

### Update my profile photo
PUT {{baseUrl}}/users/me
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=FormBoundary

--FormBoundary
Content-Disposition: form-data; name="name"

Ama Mensah
--FormBoundary
Content-Disposition: form-data; name="profilePhoto"; filename="profile.jpg"
Content-Type: image/jpeg

< {{profilePhotoPath}}
--FormBoundary--

### Change password
PUT {{baseUrl}}/users/me/password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "password123",
  "newPassword": "newpassword123"
}

### Update theme preference only
PUT {{baseUrl}}/users/me/preferences
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "theme": "dark"
}

### Update notification preferences only
PUT {{baseUrl}}/users/me/preferences
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "notifications": {
    "order": { "email": false },
    "system": { "email": true, "inApp": false }
  }
}

### Update theme and notification preferences together
PUT {{baseUrl}}/users/me/preferences
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "theme": "system",
  "notifications": {
    "chat": { "email": false },
    "review": { "email": false }
  }
}

### Request an email change (sends a confirmation link to the new address)
POST {{baseUrl}}/users/me/email-change
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "password123",
  "newEmail": "ama.new@example.com"
}

### Confirm an email change with the token from the confirmation email
POST {{baseUrl}}/users/email-change/confirm
Content-Type: application/json

{
  "token": "paste_email_change_token_here"
}

### Public user profile
GET {{baseUrl}}/users/{{username}}
